---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES } from '../../consts';
import { getArticles } from '../../lib/articles';

// Genera una página por cada categoría de src/consts.ts
export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const articles = (await getArticles()).filter((a) => a.data.category === category.slug);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: category.name, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<BaseLayout title={category.name} description={category.description} jsonLd={[breadcrumb]}>
  <nav aria-label="Ruta de navegación" class="text-sm text-zinc-600 dark:text-zinc-400">
    <a href="/" class="hover:underline">Inicio</a> / <span aria-current="page">{category.name}</span>
  </nav>
  <h1 class="mt-2 text-4xl font-bold">{category.name}</h1>
  <p class="mt-2 text-lg text-zinc-700 dark:text-zinc-300">{category.description}</p>

  {articles.length > 0 ? (
    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((a, i) => <ArticleCard article={a} eager={i === 0} />)}
    </div>
  ) : (
    <p class="mt-10 text-zinc-700 dark:text-zinc-300">Todavía no hay artículos en esta categoría. ¡Vuelve pronto!</p>
  )}
</BaseLayout>
