---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

// Formspree (plan gratuito): crea un formulario en formspree.io y pega su ID en .env
// Si la variable está vacía, la página solo muestra el correo.
const formId = import.meta.env.PUBLIC_FORMSPREE_ID;
const field = 'mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 dark:border-zinc-700 dark:bg-zinc-900';
---

<BaseLayout title="Contacto" description={`Escríbele al equipo de ${SITE.name}: dudas, correcciones, ideas de artículos o colaboraciones.`}>
  <div class="mx-auto max-w-xl">
    <h1 class="text-4xl font-bold">Contacto</h1>
    <p class="mt-4 text-lg text-zinc-700 dark:text-zinc-300">
      ¿Una duda, una corrección o una idea para un artículo? Escríbenos. Respondemos en un máximo de 3 días hábiles.
    </p>
    <p class="mt-4">
      Correo: <a href={`mailto:${SITE.email}`} class="font-semibold text-brand-700 hover:underline dark:text-brand-400">{SITE.email}</a>
    </p>

    {formId && (
      <form action={`https://formspree.io/f/${formId}`} method="POST" class="mt-8 space-y-5">
        <div>
          <label for="nombre" class="font-medium">Nombre</label>
          <input id="nombre" name="nombre" required autocomplete="name" class={field} />
        </div>
        <div>
          <label for="email" class="font-medium">Correo electrónico</label>
          <input id="email" name="email" type="email" required autocomplete="email" class={field} />
        </div>
        <div>
          <label for="mensaje" class="font-medium">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="6" required class={field}></textarea>
        </div>
        <!-- Campo trampa contra spam: los humanos no lo ven -->
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
        <p class="text-sm text-zinc-600 dark:text-zinc-400">
          Usaremos tus datos solo para responderte. Lee nuestra <a href="/politica-de-privacidad" class="underline">política de privacidad</a>.
        </p>
        <button type="submit" class="rounded-full bg-brand-700 px-6 py-2 font-semibold text-white hover:bg-brand-600">Enviar</button>
      </form>
    )}
  </div>
</BaseLayout>
