---
import { SITE, CATEGORIES } from '../consts';

const path = Astro.url.pathname;
const isActive = (slug: string) => path.startsWith(`/categoria/${slug}`);
const linkClass = 'rounded px-2 py-1 text-sm font-medium hover:text-brand-700 dark:hover:text-brand-400';
---

<header class="border-b border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="font-serif text-2xl font-bold tracking-tight">
      Byte<span class="text-brand-700 dark:text-brand-400"> Práctico</span>
    </a>

    <!-- Menú de escritorio -->
    <nav aria-label="Categorías" class="hidden lg:block">
      <ul class="flex gap-1">
        {CATEGORIES.map((c) => (
          <li>
            <a href={`/categoria/${c.slug}`} class={linkClass} aria-current={isActive(c.slug) ? 'page' : undefined}>
              {c.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/buscar" class={linkClass} aria-label="Buscar en el sitio">Buscar</a>
      <a
        href="/newsletter"
        class="hidden rounded-full bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-600 sm:inline-block"
      >
        Newsletter
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="rounded p-2 hover:bg-zinc-100 dark:hover:bg-zinc-800"
        aria-label="Cambiar entre modo claro y oscuro"
      >
        <!-- Luna en modo claro, sol en modo oscuro -->
        <svg class="h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="hidden h-5 w-5 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <!-- Menú móvil: <details> funciona con teclado y sin JavaScript -->
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded p-2 hover:bg-zinc-100 dark:hover:bg-zinc-800" aria-label="Abrir menú">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav
          aria-label="Menú principal"
          class="absolute right-0 z-40 mt-2 w-56 rounded-lg border border-zinc-200 bg-white p-2 shadow-lg dark:border-zinc-800 dark:bg-zinc-900"
        >
          <ul>
            {CATEGORIES.map((c) => (
              <li><a href={`/categoria/${c.slug}`} class={`block ${linkClass}`}>{c.name}</a></li>
            ))}
            <li><a href="/newsletter" class={`block ${linkClass}`}>Newsletter</a></li>
            <li><a href="/sobre-nosotros" class={`block ${linkClass}`}>Sobre {SITE.name}</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Guarda la preferencia del usuario para la próxima visita
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
