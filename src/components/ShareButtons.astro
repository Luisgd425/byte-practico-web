---
// Enlaces para compartir. Son enlaces simples: no cargan scripts de redes sociales (más rápido y sin rastreo).
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const networks = [
  { name: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}` },
  { name: 'X', href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
];
---

<div class="flex flex-wrap items-center gap-2 text-sm">
  <span class="font-semibold">Compartir:</span>
  {networks.map((n) => (
    <a
      href={n.href}
      target="_blank"
      rel="noopener"
      class="rounded-full border border-zinc-300 px-3 py-1 hover:border-brand-600 hover:text-brand-700 dark:border-zinc-700 dark:hover:text-brand-400"
    >
      {n.name}
    </a>
  ))}
  <button
    type="button"
    data-copy={url}
    class="rounded-full border border-zinc-300 px-3 py-1 hover:border-brand-600 hover:text-brand-700 dark:border-zinc-700 dark:hover:text-brand-400"
  >
    Copiar enlace
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      btn.textContent = '¡Copiado!';
    }),
  );
</script>
