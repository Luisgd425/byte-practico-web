---
// Caja de suscripción para el inicio y los artículos.
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  title?: string;
}
const { title = 'Recibe lo más importante de tecnología e IA cada mañana' } = Astro.props;
---

<aside
  class="not-prose my-10 rounded-xl border border-brand-600/30 bg-brand-500/5 p-6 dark:border-brand-400/30 dark:bg-brand-400/5"
  aria-label="Suscripción a la newsletter"
  data-pagefind-ignore
>
  <p class="font-serif text-xl font-bold">{title}</p>
  <p class="mt-2 mb-4 text-zinc-700 dark:text-zinc-300">
    5 noticias explicadas en 5 minutos, con por qué te importan. Gratis y sin spam.
  </p>
  <NewsletterForm />
</aside>
