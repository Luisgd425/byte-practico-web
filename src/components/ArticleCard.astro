---
// Tarjeta de artículo para listados (inicio, categorías, relacionados).
import { Image } from 'astro:assets';
import { articleUrl, categoryName, formatDate, readingTime, type Article } from '../lib/articles';

interface Props {
  article: Article;
  large?: boolean; // Versión grande para el artículo destacado
  eager?: boolean; // Carga inmediata solo para la primera imagen visible (mejora LCP)
}

const { article, large = false, eager = false } = Astro.props;
const { data } = article;
const Heading = large ? 'h2' : 'h3';
---

<article class={`group flex flex-col ${large ? 'gap-5 md:flex-row md:items-center' : 'gap-3'}`}>
  {data.heroImage && (
    <a href={articleUrl(article)} class={large ? 'md:w-3/5' : ''} tabindex="-1" aria-hidden="true">
      <Image
        src={data.heroImage}
        alt=""
        widths={large ? [480, 800, 1200] : [400, 640]}
        sizes={large ? '(min-width: 768px) 60vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        class="aspect-video w-full rounded-lg object-cover"
      />
    </a>
  )}
  <div class={large ? 'md:w-2/5' : ''}>
    <p class="text-xs font-semibold tracking-wide text-brand-700 uppercase dark:text-brand-400">
      <a href={`/categoria/${data.category}`} class="hover:underline">{categoryName(data.category)}</a>
      {data.draft && <span class="ml-2 rounded bg-amber-200 px-1.5 text-amber-900">Borrador</span>}
    </p>
    <Heading class={`mt-1 font-bold leading-tight ${large ? 'text-3xl' : 'text-xl'}`}>
      <a href={articleUrl(article)} class="hover:text-brand-700 dark:hover:text-brand-400">{data.title}</a>
    </Heading>
    <p class="mt-2 text-zinc-700 dark:text-zinc-300">{data.description}</p>
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time> · {readingTime(article.body)} min de lectura
    </p>
  </div>
</article>
