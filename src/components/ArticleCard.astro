---
// Tarjeta de artículo para listados (inicio, categorías, relacionados).
// Al pasar el mouse se eleva y la imagen hace un zoom suave (solo si el visitante no pidió menos movimiento).
import { Image } from 'astro:assets';
import { articleUrl, categoryName, formatDate, readingTime, type Article } from '../lib/articles';

interface Props {
  article: Article;
  large?: boolean; // Versión grande para el artículo destacado
  eager?: boolean; // Carga inmediata solo para la primera imagen visible (mejora LCP)
}

const { article, large = false, eager = false } = Astro.props;
const { data } = article;
const Heading = large ? 'h2' : 'h3';
---

<article
  class:list={[
    'group relative flex h-full flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm transition duration-300',
    'hover:border-brand-500/40 hover:shadow-xl hover:shadow-brand-700/10 motion-safe:hover:-translate-y-1',
    'dark:border-zinc-800 dark:bg-zinc-900/60 dark:hover:border-brand-400/40',
    large && 'md:flex-row md:items-stretch',
  ]}
>
  {data.heroImage && (
    <a href={articleUrl(article)} class:list={['block overflow-hidden', large && 'md:w-3/5']} tabindex="-1" aria-hidden="true">
      <Image
        src={data.heroImage}
        alt=""
        widths={large ? [480, 800, 1200] : [400, 640]}
        sizes={large ? '(min-width: 768px) 60vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        class="aspect-video h-full w-full object-cover transition duration-500 motion-safe:group-hover:scale-105"
      />
    </a>
  )}
  <div class:list={['flex flex-1 flex-col p-5', large && 'md:w-2/5 md:justify-center md:p-8']}>
    <p class="text-xs font-semibold tracking-wide uppercase">
      <a
        href={`/categoria/${data.category}`}
        class="relative z-10 rounded-full bg-brand-500/10 px-2.5 py-1 text-brand-700 transition hover:bg-brand-500/20 dark:text-brand-400"
      >{categoryName(data.category)}</a>
      {data.draft && <span class="ml-2 rounded-full bg-amber-200 px-2 py-1 text-amber-900">Borrador</span>}
    </p>
    <Heading class:list={['mt-3 font-bold leading-tight', large ? 'text-2xl sm:text-3xl md:text-4xl' : 'text-xl']}>
      <!-- El enlace del título cubre toda la tarjeta (clic en cualquier parte) -->
      <a href={articleUrl(article)} class="transition-colors after:absolute after:inset-0 group-hover:text-brand-700 dark:group-hover:text-brand-400">{data.title}</a>
    </Heading>
    <p class="mt-2 text-zinc-700 dark:text-zinc-300">{data.description}</p>
    <p class="mt-auto pt-4 text-sm text-zinc-600 dark:text-zinc-400">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time> · {readingTime(article.body)} min de lectura
      <span aria-hidden="true" class="ml-1 inline-block transition motion-safe:group-hover:translate-x-1">→</span>
    </p>
  </div>
</article>
