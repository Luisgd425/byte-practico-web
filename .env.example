# Copia este archivo como `.env` (para tu computadora) y rellena los valores.
# En Cloudflare Pages se ponen en: Settings > Environment variables.
# Las variables que empiezan con PUBLIC_ son visibles en el navegador: nunca pongas ahí claves secretas.
# Si una variable está vacía, esa función simplemente no se muestra.

# --- Google AdSense --------------------------------------------------------
# ID de publicador: AdSense > Cuenta > Información de la cuenta. Formato: ca-pub-1234567890123456
PUBLIC_ADSENSE_CLIENT=
# ID de cada bloque de anuncios (AdSense > Anuncios > Por bloque de anuncios > Display). Solo números.
PUBLIC_ADSENSE_SLOT_TOP=
PUBLIC_ADSENSE_SLOT_MID=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
# true = usar el CMP certificado de Google (AdSense > Privacidad y mensajes) en lugar de nuestro banner.
# Recomendado si tienes visitas de Europa, Reino Unido o Suiza.
PUBLIC_USE_GOOGLE_CMP=false

# --- Google Analytics 4 ----------------------------------------------------
# ID de medición: GA4 > Administrar > Flujos de datos > Web. Formato: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# --- beehiiv (newsletter) --------------------------------------------------
# URL del formulario embebido: beehiiv > Audience > Subscribe forms > Embed (solo la URL del src del iframe)
# Ejemplo: https://embeds.beehiiv.com/00000000-0000-0000-0000-000000000000
PUBLIC_BEEHIIV_EMBED_URL=

# --- Formspree (formulario de contacto) ------------------------------------
# ID del formulario: formspree.io > tu formulario > la parte final de https://formspree.io/f/XXXXXXXX
PUBLIC_FORMSPREE_ID=

# --- Script diario: npm run digest (Fase 4) ---------------------------------
# Basta con UNA de estas dos. Ambas son SECRETAS: no empiezan con PUBLIC_ y nunca se suben a GitHub.
#
# Opción gratis: token de GitHub con permiso "Models" (GitHub > Settings > Developer settings >
# Personal access tokens > Fine-grained tokens > Generate new token > Permissions: Models = Read-only).
# Solo hace falta para correr el script en tu computadora: en GitHub Actions ya viene incluido.
GITHUB_TOKEN=
# Opcional: modelo de GitHub Models (catálogo en github.com/marketplace/models). Por defecto openai/gpt-4.1
GITHUB_MODEL=
#
# Opción de pago (por uso): clave de la API de Claude (console.anthropic.com > API keys).
# Si está llena, tiene prioridad sobre GITHUB_TOKEN. En GitHub Actions va como secret ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
